FROM registry.cn-hangzhou.aliyuncs.com/sqdockler/simple_sq_music_plus:latest AS builder

WORKDIR /build
COPY src/main/java/com/sqmusicplus/v3/plug/qq/entity/QQSearchEntity.java /build/src/com/sqmusicplus/v3/plug/qq/entity/QQSearchEntity.java
COPY src/main/java/com/sqmusicplus/v3/plug/qq/hander/QQHander.java /build/src/com/sqmusicplus/v3/plug/qq/hander/QQHander.java
RUN mkdir -p /build/classes && javac -cp '/app/BOOT-INF/lib/*:/app/BOOT-INF/classes' -d /build/classes \
    /build/src/com/sqmusicplus/v3/plug/qq/entity/QQSearchEntity.java \
    /build/src/com/sqmusicplus/v3/plug/qq/hander/QQHander.java

FROM registry.cn-hangzhou.aliyuncs.com/sqdockler/simple_sq_music_plus:latest

# Keep the existing production image and replace only the two QQ search classes.
COPY --from=builder /build/target/classes/com/sqmusicplus/v3/plug/qq/entity/QQSearchEntity.class /app/BOOT-INF/classes/com/sqmusicplus/v3/plug/qq/entity/QQSearchEntity.class
COPY --from=builder /build/target/classes/com/sqmusicplus/v3/plug/qq/hander/QQHander.class /app/BOOT-INF/classes/com/sqmusicplus/v3/plug/qq/hander/QQHander.class
