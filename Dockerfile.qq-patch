FROM maven:3.9.4-eclipse-temurin-21-alpine AS builder

WORKDIR /build
COPY pom.xml /build/
COPY src /build/src/
RUN mvn -q -DskipTests clean package

FROM registry.cn-hangzhou.aliyuncs.com/sqdockler/simple_sq_music_plus:latest

# Keep the existing production image and replace only the two QQ search classes.
COPY --from=builder /build/target/classes/com/sqmusicplus/v3/plug/qq/entity/QQSearchEntity.class /app/BOOT-INF/classes/com/sqmusicplus/v3/plug/qq/entity/QQSearchEntity.class
COPY --from=builder /build/target/classes/com/sqmusicplus/v3/plug/qq/hander/QQHander.class /app/BOOT-INF/classes/com/sqmusicplus/v3/plug/qq/hander/QQHander.class
